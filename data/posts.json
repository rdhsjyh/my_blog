    "content": "\uc0\u22905 \u20197 \u25991 \u23398 \u20013 \u30340 \u26377 \u38480 \u35270 \u35282 \u23637 \u24320 \u19968 \u20010 \u20010 \u24179 \u38745 \u21364 \u20174 \u19981 \u24179 \u28129 \u30340 \u25925 \u20107 \u65292 \u30475 \u20284 \u36731 \u25551 \u28129 \u20889 \u65292 \u23454 \u21017 \u26263 \u28526 \u27769 \u28044 \u65292 \u21487 \u35265 \u31508 \u21147 \u20043 \u36275 \u12290 \\n\u22905 \u23545 \u20154 \u29289 \u21629 \u36816 \u21644 \u25925 \u20107 \u24773 \u33410 \u30340 \u25226 \u25569 \u28809 \u28779 \u32431 \u38738 \u65292 \u25910 \u32437 \u33258 \u22914 \u65292 \u24120 \u20110 \u24179 \u23454 \u30340 \u23545 \u35805 \u20013 \u31359 \u25554 \u30528 \u28107 \u28435 \u30340 \u25551 \u20889 \u19982 \u35686 \u36767 \u31616 \u27905 \u30340 \u35828 \u29702 \u65292 \u35789 \u38155 \u21364 \u24182 \u19981 \u38160 \u21033 \u65292 \u20063 \u27809 \u26377 \u27969 \u20029 \u30340 \u35789 \u37319 \u65292 \u20294 \u36880 \u23383 \u36880 \u21477 \u35835 \u26469 \u65292 \u21482 \u35273 \u24471 \u35821 \u31616 \u24847 \u28145 \u65292 \u34429 \u21482 \u26159 \u28129 \u28129 \u25551 \u25721 \u65292 \u21364 \u36740 \u23613 \u24773 \u29366 \u12290 \u22240 \u20854 \u20957 \u32451 \u30340 \u31508 \u27861 \u32780 \u19981 \u35265 \u28382 \u28073 \u30340 \u21465 \u20107 \u19982 \u25234 \u29702 \u37117 \u21313 \u20998 \u29420 \u21040 \u24471 \u24403 \u65292 \u22312 \u20154 \u29289 \u23545 \u35805 \u21644 \u24515 \u29702 \u27963 \u21160 \u38388 \u31359 \u25554 \u30340 \u25551 \u20889 \u20063 \u30095 \u26391 \u32780 \u29983 \u21160 \u23500 \u26377 \u38901 \u33268 \u12290 \\n\u28982 \u32780 \u20197 \u19978 \u37117 \u26159 \u21804 \u20154 \u30340 \u12290 \\n\u25105 \u21916 \u27426 T\u22823 \u30340 \u20316 \u21697 \u65292 \u19981 \u21333 \u26159 \u22240 \u20026 \u22905 \u30340 \u31508 \u27861 \u65292 \u26356 \u26159 \u24778 \u33395 \u20110 \u22905 \u30340 \u31508 \u35843 \u12290 \u22905 \u30340 \u25991 \u23383 \u37324 \u27809 \u26377 \u30699 \u25545 \u36896 \u20316 \u30340 \u30165 \u36857 \u65292 \u21482 \u26159 \u24179 \u38745 \u30340 \u21465 \u36848 \u65292 \u36824 \u26377 \u21465 \u36848 \u19979 \u26263 \u27969 \u27769 \u28044 \u30340 \u24773 \u28526 \u12290 \\n\u35692 \u22914 \u12298 \u37027 \u20010 \u19981 \u20026 \u20154 \u30693 \u30340 \u25925 \u20107 \u12299 \u37324 \u30340 \u26472 \u26157 \u21644 \u38472 \u38125 \u29983 \u65292 \u20182 \u20204 \u30456 \u29233 \u24471 \u37027 \u20040 \u28129 \'97\'97\u23545 \u35805 \u24456 \u24179 \u38745 \u65292 \u24456 \u29712 \u30862 \u65292 \u19981 \u20687 \u22312 \u19968 \u36215 \u19981 \u20037 \u30340 \u24773 \u20387 \u65292 \u20498 \u20687 \u26612 \u31859 \u27833 \u30416 \u30340 \u22827 \u22971 \u12290 \\n\u20294 \u20182 \u20204 \u20998 \u26126 \u21448 \u29233 \u24471 \u37027 \u20040 \u28872 \'97\'97\u20687 \u26472 \u26157 \u22312 \u29577 \u40857 \u38634 \u23665 \u19979 \u30340 \u30011 \u65292 \u26127 \u40644 \u65292 \u27987 \u33395 \u65292 \u23601 \u20687 \u35201 \u29123 \u28903 \u19968 \u33324 \u65292 \u34429 \u28982 \u32463 \u23613 \u26354 \u25240 \u21364 \u19968 \u30452 \u23558 \u24444 \u27492 \u35270 \u33509 \u29645 \u23453 \u12290 \\n\u23545 \u20110 \u23567 \u35828 \u32780 \u35328 \u65292 \u20027 \u39064 \u36807 \u20110 \u40092 \u26126 \u26159 \u22823 \u24524 \u12290 \u23567 \u35828 \u30340 \'93\u29702 \'94\u26159 \u34164 \u21547 \u22312 \u25925 \u20107 \u20043 \u20013 \u30340 \u65292 \u24182 \u19981 \u29305 \u21035 \u24432 \u26174 \u20986 \u26469 \u12290 T\u22823 \u30340 \u20316 \u21697 \u36890 \u36807 \u23545 \u25991 \u20013 \u21508 \u31867 \u24418 \u35937 \u30340 \u23458 \u35266 \u25551 \u32472 \u12289 \u38544 \u21947 \u12289 \u35937 \u24449 \u26469 \u26263 \u31034 \u22905 \u25152 \u24819 \u34920 \u36798 \u30340 \u24773 \u24863 \u19982 \u24605 \u24819 \u65292 \u19981 \u38138 \u24352 \u25196 \u21385 \u65292 \u21364 \u23492 \u24936 \u36965 \u28145 \u12290 \\n\u21531 \u23376 \u24341 \u32780 \u19981 \u21457 \u65292 \u36291 \u22914 \u20063 \u12290 \\n\u23567 \u35828 \u24524 \u35763 \u20316 \u32773 \u33258 \u39038 \u33258 \u30340 \u25234 \u24773 \u65292 \u32780 \u20027 \u24352 \u25226 \u24863 \u24773 \u21253 \u35065 \u20110 \u25166 \u23454 \u30340 \u20869 \u23481 \u20043 \u20013 \u65292 \u20132 \u30001 \u20154 \u29289 \u20043 \u21475 \u21435 \u35828 \u25110 \u30001 \u24773 \u33410 \u30340 \u33258 \u28982 \u21457 \u23637 \u21435 \u26174 \u38706 \u65292 \u23567 \u35828 \u30340 \u24773 \u24863 \u24212 \u32463 \u36807 \u32784 \u24515 \u30340 \u37213 \u37247 \u19982 \u38138 \u22443 \u65292 \u22914 \u32454 \u38632 \u28459 \u28072 \u30340 \u26149 \u28526 \u65292 \u39281 \u28385 \u26377 \u21147 \u65292 \u33988 \u21183 \u24453 \u21457 \u65292 \u21364 \u20572 \u30041 \u22312 \u23558 \u35201 \u28459 \u28322 \u32780 \u26410 \u28459 \u28322 \u30340 \u29366 \u24577 \u12290 \\n\u31119 \u27004 \u25308 \u22312 \u35848 \u21450 \u12298 \u21253 \u27861 \u21033 \u22827 \u20154 \u12299 \u30340 \u21019 \u20316 \u26102 \u35828 \u65306 \'93\u33402 \u26415 \u23478 \u22312 \u20182 \u30340 \u20316 \u21697 \u20013 \u65292 \u24212 \u24403 \u20687 \u19978 \u24093 \u22312 \u36896 \u29289 \u20013 \u19968 \u26679 \u65292 \u38144 \u22768 \u21311 \u36857 \u65292 \u32780 \u21448 \u19975 \u33021 \u65307 \u21040 \u22788 \u24863 \u35273 \u24471 \u21040 \u65292 \u23601 \u26159 \u30475 \u19981 \u35265 \u20182 \u12290 \'94\\n\u32780 T\u22823 \u30340 \u25991 \u23383 \u27491 \u26159 \u22914 \u27492 \u12290 \\n\u25925 \u20107 \u20063 \u35768 \u26159 \u34394 \u20551 \u30340 \u65292 \u20294 \u20063 \u35768 \u26377 \u19968 \u37096 \u20998 \u27491 \u26469 \u28304 \u20110 \u29616 \u23454 \u65292 \u21448 \u20063 \u35768 \u23427 \u27491 \u22312 \u29616 \u23454 \u20013 \u19968 \u28857 \u28857 \u19978 \u28436 \u12290 \u26080 \u35770 \u22914 \u20309 \u65292 \u25925 \u20107 \u37324 \u30340 \u20154 \u29289 \u26159 \u34880 \u32905 \u20016 \u28385 \u30340 \u65292 \u24773 \u24863 \u26159 \u39281 \u28385 \u32780 \u25947 \u25233 \u30340 \u65292 \u22914 \u38654 \u19968 \u33324 \u22320 \u31548 \u32617 \u22312 \u23567 \u35828 \u37324 \u65292 \u22788 \u22788 \u26377 \u21448 \u22909 \u20284 \u22788 \u22788 \u26080 \u12290 \\n\u20551 \u20316 \u30495 \u26102 \u30495 \u20134 \u20551 \u65292 \u26080 \u20026 \u26377 \u22788 \u26377 \u36824 \u26080 \u12290 \\n\u34394 \u23454 \u20043 \u20013 \u65292 \u33258 \u26377 \u20094 \u22372 \u12290 \\n\u26519 \u35821 \u22530 \u22312 \u12298 \u35835 \u20070 \u30340 \u33402 \u26415 \u12299 \u20013 \u35828 \u65306 \'93\u36825 \u22909 \u20284 \u19968 \u35265 \u38047 \u24773 \u65292 \u19968 \u20010 \u35835 \u32773 \u19981 \u33021 \u30001 \u30528 \u26049 \u20154 \u25351 \u28857 \u30528 \u21435 \u29233 \u22909 \u36825 \u20010 \u25110 \u37027 \u20010 \u20316 \u23478 \u12290 \u20294 \u20182 \u19968 \u26086 \u36935 \u21040 \u20182 \u25152 \u29233 \u22909 \u30340 \u20316 \u23478 \u26102 \u65292 \u20182 \u30340 \u22825 \u24615 \u24517 \u20250 \u31435 \u21051 \u20351 \u20182 \u30693 \u36947 \u30340 \u12290 \'94\\n\u19990 \u38388 \u19975 \u29289 \u65292 \u22914 \u38706 \u20134 \u22914 \u30005 \u12290 \\n\u33021 \u22312 \u20598 \u28982 \u38388 \u36935 \u35265 \u19968 \u20010 \u21313 \u20998 \u21916 \u27426 \u30340 \u20889 \u25163 \u65292 \u19968 \u37096 \u21313 \u20998 \u21916 \u27426 \u30340 \u20316 \u21697 \u65292 \u20309 \u20854 \u26377 \u24184 \u12290 \\n\u26368 \u21518 \u65292 \u27491 \u22914 T\u22823 \u22312 \u26187 \u27743 \u24320 \u35774 \u30340 \u19987 \u26639 \u21517 \u31216 \'97\'97\u26080 \u37327 \u28193 \u21475 \u65292 \u24895 \u22905 \u30340 \u25991 \u23383 \u28193 \u25105 \u65292 \u20134 \u21487 \u28193 \u20320 \u12290 \\n\u22312 \u27492 \u38816 \u36524 \u12290 \\n",\
