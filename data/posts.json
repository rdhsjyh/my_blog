    "content": "\uc0\u20170 \u22825 \u24050 \u32463 \u24320 \u23398 \u19968 \u21608 \u22810 \u20102 \u65292 \u22351 \u28040 \u24687 \u26159 \u19979 \u23398 \u26399 \u23398 \u30340 \u19977 \u38376 \u35838 \u25171 \u30524 \u19968 \u30475 \u25105 \u37117 \u19981 \u22826 \u21916 \u27426  \u22909 \u28040 \u24687 \u26159 \u21435 \u24180 \u36825 \u19977 \u38376 \u35838 \u30340 \u25346 \u31185 \u29575 \u37117 \u24456 \u20302 \u12290 \\r\\n\u20170 \u22825 \u22312 arts \u22270 \u20070 \u39302 \u24453 \u21040 \u20843 \u28857 \u65292 \u25105 \u21644 \u26379 \u21451 \u22352 \u22312 0\u23618 \u65292 \u32842 \u22825  \u21507 \u39277  \u33258 \u20064 \u12290 \u25105 \u21457 \u29616 \u25105 \u24635 \u26159 \u24456 \u21916 \u27426 \u22312 \u23545 \u35805 \u37324 \u38754 \u25552 \u20986 \u38382 \u39064 \u65292 \u36825 \u24403 \u28982 \u26159 \u36305 \u20986 \u35805 \u39064 \u30340 \u19968 \u31181 \u26041 \u24335 \u65292 \u20294 \u37492 \u20110 \u25105 \u30340 \u22823 \u33041 \u24605 \u36335 \u27604 \u36739 \u21457 \u25955 \u23548 \u33268 \u26379 \u21451 \u20204 \u19981 \u30693 \u36947 \u25105 \u27492 \u21051 \u38382 \u30340 \u38382 \u39064 \u21644 \u21069 \u19968 \u31186 \u21457 \u29983 \u30340 \u20107 \u35831 \u26377 \u20160 \u20040 \u20851 \u31995 \u12290 \\r\\n\\t\\r\\n\u26032 \u23398 \u26399 \u25105 \u35813 \u24819 \u24819 \u25105 \u30340 \u30446 \u26631 \u21644 \u35745 \u21010 \u12290 \u36825 \u20010 \u23398 \u26399 \u24456 \u30701 \u65292 \u31232 \u37324 \u31946 \u28034 \u30340 \u36807 \u21482 \u20250 \u26356 \u30701 \u12290 \u39318 \u20808  \u19981 \u24320 \u29609 \u31505  \u35201 \u25289 \u39640 \u19968 \u28857 \u22343 \u20998 \uc0\u65292 \u25105 \u19981 \u24076 \u26395 \u26410 \u26469 \u19968 \u22534 offer\u30776 \u26197 \u25105 \u35753 \u25105 \u19981 \u30693 \u36947 \u36873 \u21738 \u20010 \u22909 \u65292 \u20294 \u25105 \u26356 \u19981 \u24076 \u26395 \u21040 \u26102 \u20505 \u22909 \u23398 \u26657 \u19968 \u28857 \u27809 \u24471 \u36873 \u12290 \\r\\n\\t\\r\\n\u19978 \u19968 \u21608 \u24320 \u23398 \u65292 \u22909 \u20037 \u27809 \u35265 \u36807 \u36825 \u20040 \u22810 \u20154 \u22312 \u24067 \u37324 \u26031 \u25176 \u65292 \u24863 \u35273 \u22478 \u24066 \u19968 \u19979 \u23376 \u27963 \u20102 \u36807 \u26469 \u65292 \u35265 \u20102 \u19981 \u23569 \u26379 \u21451 \u65292 \u21507 \u20102 \u19981 \u23569 \u20013 \u39184 \u39302 \u30340 \u39277 \u65292 \u36305 \u20102 \u20004 \u27425 \u27493 \u65292 \u36305 \u20102 \u20004 \u22825 \u22270 \u20070 \u39302 \u65292 \u36141 \u20102 \u20960 \u27425 \u29289 \u12290 \\r\\n\\t\\r\\n\u19981 \u36807 \u26377 \u19968 \u35828 \u19968  \u19968 \u30452 \u24819 \u24674 \u22797 \u25105 \u26216 \u36305 \u30340 \u20064 \u24815  \u22856 \u20309 \u26368 \u36817 \u30495 \u30340 \u24456 \u25042  \u26202 \u19978 \u19981 \u30561  \u26089 \u19978 \u19981 \u36215 \u65292 \u27809 \u26377 \u20043 \u21069 \u30340 \u37027 \u31181 \u28608 \u24773  \u20498 \u20063 \u25042 \u24471 \u33258 \u22312 \u12290 \u29983 \u27963 \u27604 \u36739 \u24179 \u28129  \u27809 \u26377 \u24456 \u29305 \u21035 \u30340 \u20107 \u24773 \u65292 \\r\\n\\t\\r\\n\u30475 \u23436 \u20102 cj\u26368 \u26032 \u30340 \u33410 \u30446 \u65292 \u21448 \u21435 \u35835 \u22905 \u21435 \u24180 \u30340 \u25991 \u31456 \u65292 \u37324 \u38754 \u30340 \u20154 \u29289 \u38463 \u33391 \u25776 \u20889 \u30340 \u25991 \u31456 \u22312 \u25105 \u22312 \u27604 \u26031 \u29305 \u22238 \u24067 \u30340 \u36335 \u19978 \u24708 \u24708 \u27969 \u30524 \u27882 \u65292 \u29616 \u22312 \u24050 \u32463 \u24456 \u23569 \u26377 \u25991 \u23383 \u21487 \u20197 \u36825 \u26679 \u28145 \u30340 \u25171 \u21160 \u25105 \u65292 \u37324 \u38754 \u27809 \u26377 \u29053 \u21160 \u20219 \u20309 \u19968 \u31181 \u24773 \u24863  \u26080 \u35770 \u26159 \u24616 \u24680 \u36824 \u26159 \u19981 \u29976 \u65292 \u26080 \u35770 \u26159 \u36951 \u25022 \u36824 \u26159 \u24754 \u21696 \u65292 \u37324 \u38754 \u21482 \u26159 \u19968 \u20010 \u20154 \u29992 \u19981 \u31639 \u38271 \u30340 \u21322 \u29983 \u32463 \u39564 \u20889 \u20986 \u26469 \u30340 \u23545 \u30171 \u33510 \u30340 \u24605 \u32771 \u65292 \u23545 \u20182 \u20154 \u30340 \u29702 \u35299 \u65292 \u23545 \u33258 \u25105 \u21644 \u29615 \u22659 \u30340 \u26576 \u19968 \u31243 \u24230 \u30340 \u21644 \u35299 \u12290 \\r\\n\\t\\r\\n\u19968 \u28857 \u28857 \u23578 \u26410 \u25104 \u29087 \u30340 \u24863 \u21463 \\r\\n\u24403 \u20320 \u19981 \u20877 \u21521 \u21035 \u20154 \u36861 \u38382 \u20026 \u20160 \u20040 \u20250 \u36825 \u26679 \u20570 \u65292 \u32780 \u26159 \u30495 \u27491 \u23581 \u35797 \u30528 \u29702 \u35299 \u20195 \u20837 \u21035 \u20154 \u30340 \u35270 \u35282 \u21162 \u21147 \u24819 \u24819 \u20182 \u36825 \u20040 \u20570 \u30340 \u21407 \u22240 \u65292 \u24456 \u22810 \u25191 \u24565 \u65292 \u19981 \u29976  \u20063 \u23601 \u22312 \u20320 \u25442 \u20301 \u30340 \u19968 \u30636 \u38388 \u24471 \u20197 \u28040 \u35299 \u22823 \u21322 \u12290  \u36825 \u20063 \u35753 \u25105 \u24819 \u21040  \'93\u38477 \u20302 \u23545 \u20182 \u20154 \u30340 \u26399 \u24453  \'94\u23454 \u38469 \u19978 \u19981 \u26159 \u38477 \u20302 \u23545 \u20182 \u20154 \u20570 \u27861 \u30340 \u32654 \u22909 \u35774 \u24819 \u65292 \u19981 \u26159 \u38477 \u20302 \u23545 \u20182 \u20154 \u30340 \u32654 \u22909 \u35780 \u20215 \u65292 \u32780 \u26159 \u38477 \u20302 \u23545 \u20182 \u20154 \u22312 \u27492 \u26102 \u27492 \u21051 \u19968 \u20010 \u20320 \u23578 \u26410 \u32463 \u21382 \u36807 \u20035 \u33267 \u20102 \u35299 \u30340 \u22788 \u22659 \u19979 \u30340 \u35201 \u27714 \u65292 \u20320 \u21487 \u20197 \u26399 \u24453  \u20294 \u26159 \u20320 \u30340 \u26399 \u24453 \u19981 \u20250 \u26102 \u26102 \u34987 \u28385 \u36275 \u12290 \\r\\n\u24819 \u24819 \u38472 \u34427 \u37027 \u21477 \u35805 \'93\u30171 \u33510 \u27809 \u26377 \u24847 \u20041 \u65292 \u23545 \u30171 \u33510 \u30340 \u24605 \u32771 \u25165 \u26377 \u24847 \u20041 ",\
