    "content": "\uc0\u20170 \u22825 \u21608 \u22235 \u65292 \u25105 \u31455 \u28982 \u25226 \u25152 \u26377 \u35838 \u37117 \u32473 \u32728 \u20102 \u65292 \u25105 \u22312 arts \u22352 \u20102 \u19968 \u19979 \u21320 \u65292 \u20026 \u20102 \u19977 \u28857 \u22235 \u21313 \u35201 \u24320 \u30340 \u32447 \u19978 \u20250 \u35758 \u32039 \u24352 \u20102 \u19968 \u22825 \u65292 \u26368 \u21518 \u37027 \u20010 \u26087 \u19994 \u26159 \u24459 \u24072 \u21518 \u26469 \u25913 \u34892 \u26102 \u23578 \u19994 \u30340 \u32769 \u24072 \u27809 \u26469  \u19977 \u20010 \u23398 \u29983 \u23545 \u30528 \u23631 \u24149 \u38754 \u38754 \u30456 \u35281 \u65292 \u21516 \u26102 \u24863 \u24936 \u34394 \u24778 \u19968 \u22330 \u12290 \\r\\n\u22352 \u22312 arts \u21917 \u20102 \u20004 \u26479 \u26080 \u31958 \u22902 \u33590 \u24320 \u22987 \u24605 \u32771 \u20154 \u29983 \u65292 \u30475 \u30528 \u35832 \u22810 \u22823 \u21378 \u30340 \u23454 \u20064 \u24191 \u21578 \u36880 \u28176 \u38519 \u20837 \u20102 \u33258 \u24049 \u20250 \u26080 \u19994 \u30340 \u36855 \u33579 \u37324 \u38754 \u12290 \\r\\n\u25171 \u24320 \u23439 \u35266 \u32463 \u27982 \u30340 \u35838 \u20214 \u32763 \u20102 \u32763 \u65292 \u30475 \u30528 \u32654 \u22269 \u21322 \u20010 \u19990 \u32426 \u30340 GDP\u23545 \u25968 \u20989 \u25968 \u24335 \u30340 \u22686 \u38271 \u65292 \u21644 \u19977 \u39029 \u30340 \u20844 \u24335 \u25512 \u23548 \u65292 \u25105 \u24320 \u22987 \u24576 \u30097 \u33258 \u24049 \u36873 \u38169 \u20102 \u19987 \u19994 \u12290 \\r\\n\u21512 \u21809 \u22242 \u25490 \u32451 \u30340 \u26102 \u20505 \u37324 \u38754 \u26377 \u20010 \u35835 \u21338 \u30340 \u22992 \u22992 \u25105 \u30475 \u30528 \u24456 \u20687 \u25105 \u35748 \u35782 \u30340 \u21478 \u19968 \u20010 \u22992 \u22992 \u65292 \u25105 \u38382 \u22905 \u20320 \u23478 \u37324 \u26159 \u19981 \u26159 \u26377 \u22992 \u22969 \u65292 \u22905 \u35828 \u22905 \u26377 \u20010 \u24351 \u24351 \u12290  \u22909 \u21543  \u25105 \u30340 \u29468 \u24819 \u19981 \u25104 \u31435 \u12290 \\r\\n\u36305 \u39064 \u20102 \u12290 \'93\u22823 \u37096 \u20998 \u22823 \u23398 \u30340 \u26412 \u31185 \u25945 \u23398 \u65292 \u19981 \u26159 \u28626 \u20020 \u23849 \u28291 \u65292 \u32780 \u26159 \u26089 \u24050 \u23849 \u28291 \u12290 \'94 \u20309 \u24847 \u21619 \u65292 \u25105 \u22914 \u26524 \u35748 \u20026 \u23427 \u23849 \u28291 \u65292 \u26159 \u19981 \u26159 \u25105 \u19981 \u19978 \u35838 \u21487 \u20197 \u34987 \u21512 \u29702 \u21270 \u12290  \u37027 \u25105 \u21448 \u20250 \u35273 \u24471 \u25105 \u30340 \u23398 \u36153 \u20132 \u30340 \u19981 \u21512 \u29702 \u12290 \u25105 \u21040 \u24213 \u22312 \u35828 \u20123 \u20160 \u20040 \\r\\n\u20170 \u26085 \u24635 \u32467 \u23601 \u26159  \u19981 \u35201 \u22240 \u20026 \u21363 \u23558 \u35201 \u19978 \u35838 \u35201 \u24320 \u20250 \u32780 \u33258 \u23547 \u28902 \u24700 \u65292 \u22240 \u20026 \u20320 \u30340 \u32769 \u24072 \u38543 \u26102 \u21487 \u33021 \u40509 \u12290 \\r\\n\u25105 \u30340 \u24847 \u24605 \u26159 \u65292 \u26379 \u21451 \u20204  \u25105 \u21482 \u26159 \u20170 \u22825 \u30340 \u22823 \u33041 \u26377 \u28857 \u20081 \u65292 \u24605 \u36335 \u20081 \u19971 \u20843 \u31967 \u30340 \u26102 \u20505 \u65292 \u32993 \u35828 \u20843 \u36947 \u19981 \u21487 \u20197 \u31639 \u25968 \u12290 ",\
